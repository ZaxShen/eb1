# Production environment for the annotation site. Copy to `.env` next to the
# compose file and fill in real values. `.env` is gitignored — never commit it.
#
#   cp .env.example .env && $EDITOR .env

# Public hostname Caddy serves + obtains a Let's Encrypt cert for. Free DuckDNS
# subdomain pointed at the VM's static IP. Also the OAuth authorized origin.
SITE_DOMAIN=eb1-annotate.duckdns.org

# Postgres superuser password (user `eb1`, db `eb1_annotation`). Use a long
# random value — NEVER the local-dev `eb1`. Keep it in sync with the password
# embedded in EB1_ANNOTATION_DSN below.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Backend -> Postgres DSN over the internal compose network (host `postgres`).
# The password here MUST match POSTGRES_PASSWORD above.
EB1_ANNOTATION_DSN=postgresql://eb1:change-me-to-a-long-random-password@postgres:5432/eb1_annotation

# Public OAuth 2.0 Web client ID (not a secret). Backend verifies ID tokens
# against this audience; must equal VITE_GOOGLE_CLIENT_ID. Leaving both unset
# disables SSO (any visitor — do not run public without SSO).
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Same client ID, baked into the frontend bundle at build time.
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Comma-separated allowlist of annotator emails (case/whitespace-insensitive).
# When set, verified accounts not on the list get 403. Unset = any verified
# Google account is allowed.
ALLOWED_EMAILS=annotator1@example.com,annotator2@example.com

# GCS bucket (name only, no gs://) for daily pg_dump backups. See RUNBOOK.md.
GCS_BACKUP_BUCKET=eb1-annotation-backups
