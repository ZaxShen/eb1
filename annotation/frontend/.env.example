# Google SSO (optional). When VITE_GOOGLE_CLIENT_ID is set, the annotation site
# requires Google sign-in and reviewed_by becomes the verified Google account
# name. When unset, the app runs in no-auth manual mode (local dev).
#
# This is the PUBLIC OAuth 2.0 Web client ID from Google Cloud Console — not a
# secret. No client secret is used. The backend must run with the SAME value in
# GOOGLE_CLIENT_ID (it verifies the ID token against this audience).
#
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Vite dev server port (proxies /api to the backend). Defaults below.
# VITE_PORT=5173
# VITE_API_PORT=8000
